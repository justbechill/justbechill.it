    "prebuild": "node scripts/clean-build.mjs"
  },
  "dependencies": {
    "astro": "7.4.4",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
