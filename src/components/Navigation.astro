---
const path = Astro.url.pathname;
const links = [{ href: '/photos/', label: 'Photos' }, { href: '/movies/', label: 'Movies' }];
---
<header class="site-header">
  <nav aria-label="Main navigation">
    <a class="brand" href="/"><img src="/photos/icon.svg" width="32" height="32" alt="" />justbechill</a>
    {links.map(link => <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>
