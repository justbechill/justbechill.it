---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { albums } from '../data/albums';
---
<Layout title="justbechill">
  <Hero title="justbechill" image="/photos/san-diego-fall/compressed/29.webp" position="50% 60%" />
  <section class="intro split">
    <img src="/photos/me.jpeg" alt="Kyle Malling" width="800" height="800" />
    <div class="panel">
      <p>I'm Kyle Malling, a UC San Diego class of '29 Computer Engineering student. I like photography, programming, and working on/building computers. This is mainly a website for my photography and the places I've been.</p>
      <p>If you want to see my nerdy stuff you can check out my <a href="https://github.com/justbechill">GitHub</a>!</p>
    </div>
  </section>
  <section class="photo-intro split">
    <div class="panel"><h2>Photo Galleries</h2><p>I upload all the decent photos that I take on trips or around where I live to this website!</p><a class="text-link" href="/photos/">See all photo albums →</a></div>
    <img src="/photos/san-diego-fall/compressed/25.webp" alt="A photograph from San Diego in fall" loading="lazy" width="900" height="600" />
  </section>
  <section aria-label="Latest photo album" class="album-list latest"><AlbumCard album={albums[0]} /></section>
</Layout>
