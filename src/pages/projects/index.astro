---
import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    name: 'clockem',
    category: 'WAYLAND · DESKTOP WIDGETS',
    description: 'A little more life on the Linux desktop. Clock, weather, and wallpaper widgets for Wayland.',
    contribution: 'I developed the desktop widgets and added configurable window sizes, weather support, and CSS styling options.',
    image: '/photos/san-diego-winter/compressed/02.webp',
    alt: 'Sunlight on a wall beside stacked chairs and a window',
  },
  {
    name: 'metro-panel',
    category: 'RUST · HARDWARE',
    description: 'My take on a more affordable Metro Board, inspired by the display from Design Rules Co.',
    contribution: 'I started the project and wrote the initial Rust code for the display, LCD interface, and menu system.',
    image: '/photos/japan/compressed/04.webp',
    alt: 'Purple hydrangeas beside a garden path in Japan',
  },
  {
    name: 'freighter',
    category: 'RUST · DEVELOPER TOOLS',
    description: 'A small command-line tool for installing my personal projects.',
    contribution: 'I built the command-line argument parsing and freighter.toml configuration support, and documented the installation workflow.',
    image: '/photos/los-angeles/compressed/20.webp',
    alt: 'A photograph from my Los Angeles album',
  },
];
---
<Layout title="Projects" description="A selection of Kyle Malling’s public GitHub projects, from Wayland widgets to hardware and developer tools.">
  <header class="projects-heading">
    <p class="eyebrow">THINGS I'VE BEEN BUILDING</p>
    <h1>Projects</h1>
    <p>A few experiments in software, hardware, and making things my own.</p>
    <a class="text-link" href="https://github.com/justbechill">More on GitHub <span aria-hidden="true">↗</span></a>
  </header>
  <div class="project-list">
    {projects.map((project, index) => (
      <section class="project-card" aria-labelledby={`project-${project.name}`}>
        <figure>
          <img src={project.image} alt={project.alt} width="900" height="600" decoding="async" />
          <figcaption>Photo placeholder · from my image albums</figcaption>
        </figure>
        <div class="project-details">
          <p class="eyebrow"><span class="project-number">0{index + 1}</span> {project.category}</p>
          <h2 id={`project-${project.name}`}>{project.name}</h2>
          <p>{project.description}</p>
          <p class="project-contribution"><strong>My contribution</strong>{project.contribution}</p>
          <a class="text-link" href={`https://github.com/justbechill/${project.name}`}>View {project.name} on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    ))}
  </div>
</Layout>
