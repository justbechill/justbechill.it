---
import Layout from "../../layouts/Layout.astro";

const projects = [
    {
        name: "clockem",
        url: "https://github.com/justbechill/clockem",
        category: "WAYLAND · DESKTOP WIDGETS",
        description:
            "Clock, weather, and wallpaper widgets for Wayland. A way for me to get into Rust.",
        contribution: "I am the sole contributor",
        image: "/photos/clockem.png",
        alt: "Example of widgets using Clockem",
    },
    {
        name: "2024 - Crescendo",
        url: "https://github.com/poly-rabbotics/2024-Crescendo",
        category: "JAVA · ROBOTICS",
        description:
            "I was a programming lead for FRC Team 7042 (Poly Rabbotics) in 2023 and 2024.",
        contribution:
            "The non-drive mechanisms are almost entirely programmed by me, along with some contributions to other parts of the robot",
        image: "/photos/mantis.webp",
        alt: 'Our 2024 robot "Mantis"',
    },
];
---

<Layout
    title="Projects"
    description="A selection of Kyle Malling’s public GitHub projects, from Wayland widgets to hardware and developer tools."
>
    <header class="projects-heading">
        <p class="eyebrow">THINGS I'VE BUILT (OR AM BUILDING)</p>
        <h1>Projects</h1>

        <a
            class="text-link"
            href="https://github.com/justbechill"
            target="_blank"
            rel="noopener noreferrer"
        >
            More on GitHub <span aria-hidden="true">↗</span>
        </a>
    </header>
    <div class="project-list">
        {projects.map((project, index) => (
            <section
                class="project-card"
                aria-labelledby={`project-${project.name}`}
            >
                <figure>
                    <img
                        src={project.image}
                        alt={project.alt}
                        width="900"
                        height="600"
                        decoding="async"
                    />
                    <figcaption>Project photo</figcaption>
                </figure>
                <div class="project-details">
                    <p class="eyebrow">
                        <span class="project-number">0{index + 1}</span>{" "}
                        {project.category}
                    </p>
                    <h2 id={`project-${project.name}`}>{project.name}</h2>
                    <p>{project.description}</p>
                    <p class="project-contribution">
                        <strong>My contribution</strong>
                        {project.contribution}
                    </p>
                    <a
                        class="text-link"
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        View {project.name} <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
        ))}
    </div>
</Layout>
